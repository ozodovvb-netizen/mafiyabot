# --- Bot ---
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
BOT_USERNAME=Sherif_mafiabot

# Vergul bilan ajratilgan, birinchi (bosh) adminlaringiz ID lari
SUPER_ADMINS=123456789,987654321

# (Ixtiyoriy) Yashirin admin(lar) -- to'liq admin huquqiga ega, LEKIN botdagi
# "Adminlar" ro'yxatida hech qachon ko'rinmaydi (u ro'yxat faqat bazadagi
# adminlarni ko'rsatadi). Vergul bilan ajratib ID kiriting. Bo'sh qoldirsangiz,
# hech kim yashirin admin bo'lmaydi.
# HIDDEN_ADMINS=123456789

# --- Baza ---
# Lokal PostgreSQL uchun:
DATABASE_URL=postgresql+asyncpg://mafia_user:mafia_pass@localhost:5432/mafia_bot

# Railway uchun: Postgres servisidan "DATABASE_URL" (yoki "DATABASE_PUBLIC_URL")
# qiymatini nusxalab shu yerga qo'ying -- postgres:// yoki postgresql:// bo'lsa ham
# bot o'zi avtomatik postgresql+asyncpg:// ga o'giradi, hech narsani qo'lda o'zgartirish shart emas.
# Masalan:
# DATABASE_URL=postgresql://postgres:xxxxxxxx@viaduct.proxy.rlwy.net:12345/railway
#
# Agar ulanishda SSL talab qilinsa (odatda Railway'ning tashqi/public ulanishida kerak bo'lmaydi,
# lekin xatolik chiqsa sinab ko'ring):
# DATABASE_SSL=true

# --- O'yin sozlamalari (ixtiyoriy, o'zgartirmasangiz ham ishlaydi) ---
MIN_PLAYERS=5
MAX_PLAYERS=45
REGISTRATION_SECONDS=90
NIGHT_SECONDS=40
DAY_DISCUSSION_SECONDS=60
VOTING_SECONDS=30
LAST_WORDS_SECONDS=30
FREE_MONEY_DAILY_LIMIT=3
GENDER_CHANGE_LIMIT=3
